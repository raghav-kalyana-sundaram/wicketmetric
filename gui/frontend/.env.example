# Cricket Metrics — Frontend environment example
# Copy to .env.local for local dev. In production (Vercel), set these in the dashboard.

# Base URL of the Cricket Metrics API (no trailing slash).
# Leave empty when using Vite dev proxy (default) or Vercel Services (gui/ root + same-origin /api).
# Only set this when the API is on another host (legacy split deploy). Example:
# VITE_API_URL=https://api.example.com
VITE_API_URL=

# Optional: canonical URL shown on exported graphics (defaults to window.location.origin).
# VITE_SITE_URL=https://your-domain.com
