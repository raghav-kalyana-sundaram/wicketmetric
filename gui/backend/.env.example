# Cricket Metrics — Backend environment example
# Copy to .env in this folder (gui/backend/) for local dev. The FastAPI app loads
# this file on startup (Uvicorn does not). Restart the backend after editing .env.
# On Railway, set these in the project Variables instead.

# Optional: Root directory for pipeline data. The backend looks for format data under this path:
#   - DATA_ROOT/output/mens_t20i, … (deployed volume), or DATA_ROOT/data/output/… (full data tree copy)
#   - DATA_ROOT/output_t20i / output_ipl (legacy men's layout)
# Local dev default: project data/output/ (no DATA_ROOT needed).
# Use in Docker/Railway when data is mounted (e.g. DATA_ROOT=/data).
# DATA_ROOT=/data

# Optional: Single pipeline output directory (legacy single-format mode). Only one format is loaded.
# OUTPUT_DIR=/path/to/output

# Optional: Comma-separated list of allowed CORS origins (e.g. your Vercel frontend URL).
# Example: https://your-app.vercel.app,https://your-custom-domain.com
# CORS_ORIGINS=

# ── ESPN live scoreboard proxy (unofficial upstream; optional) ─────
# Set to false to disable /api/live/espn/cricket/scoreboard without removing the route.
# ESPN_LIVE_PROXY_ENABLED=true

# Cache TTL in seconds (default 90). Reduces load on ESPN’s public JSON API.
# ESPN_CRICKET_SCOREBOARD_CACHE_SEC=90

# Max cached query keys per process (default 32). Oldest entries evicted when over cap.
# ESPN_CRICKET_SCOREBOARD_CACHE_MAX_ENTRIES=32

# Max cached match-summary keys (default 48) for GET .../cricket/summary.
# ESPN_CRICKET_SUMMARY_CACHE_MAX_ENTRIES=48
