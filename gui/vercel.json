{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "services",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/vercel_entry.py",
      "routePrefix": "/api",
      "framework": "fastapi",
      "maxDuration": 300,
      "memory": 3008
    }
  }
}
